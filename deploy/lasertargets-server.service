[Unit]
Description=LaserTargets Server
Documentation=https://github.com/joela/lasertargets
After=network.target
Wants=network.target

[Service]
Type=simple
User=lasertargets
Group=lasertargets
ExecStartPre=-/bin/sh -c 'echo performance | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor >/dev/null 2>&1 || true'
ExecStartPre=-/bin/sh -c 'echo -1 | tee /sys/module/usbcore/parameters/autosuspend >/dev/null 2>&1 || true'
ExecStart=/opt/lasertargets/server
Environment=LD_LIBRARY_PATH=/opt/lasertargets/lib
Environment=RUST_LOG=info

# Auto-restart disabled during development (start manually or via systemctl start)
Restart=no
# RestartSec=5
# StartLimitBurst=3
# StartLimitIntervalSec=60

# Hardening
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/lasertargets /mnt/usb-logs
# Allow the DAC output thread to set SCHED_FIFO real-time scheduling
AmbientCapabilities=CAP_SYS_NICE
CapabilityBoundingSet=CAP_SYS_NICE

# Logging to systemd journal (view with: sudo journalctl -u lasertargets-server -f)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

